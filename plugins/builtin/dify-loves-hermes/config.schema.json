{
  "type": "object",
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Dify API URL",
      "description": "Dify 服务的 /v1 根地址"
    },
    "api_key": {
      "type": "string",
      "title": "Dify App API Key",
      "secret": true
    },
    "app_type": {
      "type": "string",
      "title": "应用类型",
      "enum": ["chat", "completion", "workflow"]
    },
    "model": {
      "type": "string",
      "title": "兼容模型名称"
    },
    "port": {
      "type": "integer",
      "title": "本地监听端口",
      "minimum": 1024,
      "maximum": 65535
    },
    "user_prefix": {
      "type": "string",
      "title": "Dify 用户前缀"
    },
    "tool_bridge": {
      "type": "boolean",
      "title": "启用外部工具桥"
    },
    "timeout_seconds": {
      "type": "integer",
      "title": "请求超时（秒）",
      "minimum": 5,
      "maximum": 600
    }
  },
  "required": ["base_url", "app_type", "model", "port"]
}
