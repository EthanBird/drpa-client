{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "appimage",
      "deb"
    ],
    "resources": {
      "resources/linux/runtime/": "runtime/"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libgbm1",
          "libnss3",
          "xdg-utils"
        ],
        "priority": "optional",
        "section": "devel"
      }
    }
  }
}
